---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectCard from './ProjectCard.astro';
import { site, socialLinks } from '../data/site';
import { getContent } from '../i18n/content';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { profile, labels, projects, capabilities, career, highlights } = getContent(locale);
const categories = ['all', 'institutional', 'product', 'concept'] as const;
---
<BaseLayout locale={locale}>
  <Header locale={locale} />
  <main id="main-content">
    <section class="hero section" id="home" aria-labelledby="hero-title">
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-content" data-reveal>
          <div class="eyebrow hero-eyebrow"><span class="availability-dot"></span><span>{profile.availability}</span></div>
          <p class="hero-kicker">{labels.heroKicker} {site.name.toUpperCase()} <span>—</span> {labels.heroRole}</p>
          <h1 id="hero-title">{labels.heroLineOne}<span class="hero-line">.</span><br />{labels.heroLineTwo} <span class="hero-gradient">{labels.heroSolution}</span></h1>
          <p class="hero-description">{profile.description}</p>
          <div class="hero-buttons">
            <a href="#projects" class="button button-primary">{labels.exploreProjects} <span aria-hidden="true">↗</span></a>
            <a href="#contact" class="button button-ghost">{labels.workTogether} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-lower">
            <div class="hero-lower-line" aria-hidden="true"></div>
            <span><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5v13m0 0-5-5m5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> {labels.scrollToExplore}</span>
            <span>{profile.location}</span>
          </div>
        </div>
        <div class="hero-art" aria-label={labels.heroArtLabel} data-reveal>
          <div class="hero-halo" aria-hidden="true"></div>
          <div class="art-mesh" aria-hidden="true"></div>
          <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
          <div class="hero-code-card" aria-hidden="true">
            <div class="code-header"><span><i></i><i></i><i></i></span><span>solution.ts</span><span>↗</span></div>
            <div class="code-lines"><span><em>01</em> <b class="code-purple">const</b> developer = &#123;</span><span><em>02</em> &nbsp; focus: <b class="code-lime">'impact'</b>,</span><span><em>03</em> &nbsp; mindset: <b class="code-lime">'build'</b>,</span><span><em>04</em> &nbsp; quality: <b class="code-lime">'always'</b></span><span><em>05</em> &#125;;</span><span><em>06</em></span><span><em>07</em> <b class="code-purple">export default</b> developer;</span></div>
            <div class="code-footer"><span>● &nbsp; {labels.codeStatus}</span><span>UTF-8 &nbsp; TS</span></div>
          </div>
          <div class="hero-chip hero-chip-top" aria-hidden="true"><span>✳</span><b>{labels.codeDesign}</b><small>{labels.codeIntent}</small></div>
          <div class="hero-chip hero-chip-bottom" aria-hidden="true"><span>↗</span><b>{labels.codeBuild}</b><small>{labels.codeJudgment}</small></div>
          <div class="hero-art-corner" aria-hidden="true">Y — 26</div>
        </div>
      </div>
      <div class="hero-bottom-line" aria-hidden="true"></div>
    </section>

    <div class="ticker" aria-label={labels.ticker}>
      <div class="container ticker-inner">
        <span>REACT</span><span class="ticker-dot">✳</span><span>NODE.JS</span><span class="ticker-dot">✳</span><span>POSTGRESQL</span><span class="ticker-dot">✳</span><span>ASTRO</span><span class="ticker-dot">✳</span><span>{labels.architecture}</span><span class="ticker-dot">✳</span><span>{labels.digitalProduct}</span>
      </div>
    </div>

    <section id="projects" class="section section-projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-header" data-reveal>
          <div>
            <div class="section-label"><span>01</span> / {labels.selectedWork}</div>
            <h2 id="projects-title">{labels.projectsTitle} <em>{labels.projectsEmphasis}</em></h2>
          </div>
          <p>{labels.projectsIntro}</p>
        </div>
        <div class="filter-bar" role="group" aria-label={labels.filterProjects} data-reveal>
          {categories.map((category, i) => (
            <button type="button" class:list={['filter-button', i === 0 && 'active']} data-filter={category} aria-pressed={i === 0}>{category === 'all' ? labels.all : labels.categories[category]}<span>{category === 'all' ? projects.length.toString().padStart(2, '0') : projects.filter((p) => p.category === category).length.toString().padStart(2, '0')}</span></button>
          ))}
        </div>
        <div class="project-grid" data-project-grid>
          {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} locale={locale} />)}
        </div>
        <p class="projects-note" data-reveal><span aria-hidden="true">↳</span> {labels.projectsNote}</p>
      </div>
    </section>

    <section id="expertise" class="section section-services" aria-labelledby="services-title">
      <div class="container">
        <div class="section-header section-header-stacked" data-reveal>
          <div class="section-label"><span>02</span> / {labels.whatIDo}</div>
          <h2 id="services-title">{labels.expertiseTitle}<br /><em>{labels.expertiseEmphasis}</em></h2>
        </div>
        <div class="services-grid">
          {capabilities.map((item) => (
            <article class="service-card" data-reveal>
              <div class="service-top"><span>{item.index} / 03</span><span class="service-icon" aria-hidden="true">
                {item.icon === 'window' && <svg viewBox="0 0 32 32" width="32" height="32" fill="none"><rect x="3" y="6" width="26" height="20" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M3 12h26M9 9h.1M13 9h.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
                {item.icon === 'layers' && <svg viewBox="0 0 32 32" width="32" height="32" fill="none"><path d="m16 4 12 6.5-12 6.5L4 10.5 16 4ZM4 16l12 7 12-7M4 22l12 7 12-7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>}
                {item.icon === 'spark' && <svg viewBox="0 0 32 32" width="32" height="32" fill="none"><path d="M16 2v28M2 16h28M6.1 6.1l19.8 19.8M25.9 6.1 6.1 25.9" stroke="currentColor" stroke-width="1.5"/><circle cx="16" cy="16" r="5" fill="currentColor"/></svg>}
              </span></div>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
              <div class="service-tags">{item.tags.map((tag) => <span>{tag}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="section section-about" aria-labelledby="about-title">
      <div class="container about-grid">
        <div class="about-left" data-reveal>
          <div class="section-label"><span>03</span> / {labels.aLittleAbout}</div>
          <h2 id="about-title">{labels.aboutTitle} <em>{labels.aboutEmphasis}</em></h2>
          <div class="about-monogram" aria-hidden="true"><span>Y</span><i>{labels.monogramTagline}</i></div>
        </div>
        <div class="about-right" data-reveal>
          <p class="about-lead">{labels.aboutLead}</p>
          <p class="about-copy">{profile.about}</p>
          <div class="highlight-list">
            {highlights.map((highlight) => <div><span aria-hidden="true">✳</span><p>{highlight}</p></div>)}
          </div>
          <h3 class="timeline-heading">{labels.career}</h3>
          <div class="timeline">
            {career.map((item) => (
              <article class="timeline-item">
                <span class="timeline-date">{item.period}</span>
                <div><h4>{item.job}</h4><strong>{item.organization}</strong><p>{item.summary}</p></div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section section-principles" aria-label={labels.myApproach}>
      <div class="container principles-grid">
        <div class="principle-lead" data-reveal><span>{labels.myApproach}</span><h2>{labels.approachTitle}<br /><em>{labels.approachEmphasis}</em></h2></div>
        <div class="principle" data-reveal><span>01 /</span><h3>{labels.principleClarity}</h3><p>{labels.principleClarityText}</p></div>
        <div class="principle" data-reveal><span>02 /</span><h3>{labels.principleQuality}</h3><p>{labels.principleQualityText}</p></div>
        <div class="principle" data-reveal><span>03 /</span><h3>{labels.principleDelivery}</h3><p>{labels.principleDeliveryText}</p></div>
      </div>
    </section>

    <section id="contact" class="section section-contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <div class="contact-glow" aria-hidden="true"></div>
        <div class="contact-top" data-reveal><span class="section-label"><span>04</span> / {labels.contact}</span><span class="contact-availability"><span class="availability-dot"></span>{profile.availability}</span></div>
        <div data-reveal>
          <h2 id="contact-title">{labels.contactTitle}<br /><em>{labels.contactEmphasis}</em></h2>
          <p>{labels.contactIntro}</p>
          <div class="contact-actions">
            {site.email ? <a href={`mailto:${site.email}?subject=${encodeURIComponent(labels.emailSubject)}`} class="button button-primary">{labels.sendEmail} <span aria-hidden="true">↗</span></a> : <a href={site.github} target="_blank" rel="noopener noreferrer" class="button button-primary">{labels.exploreGithub} <span aria-hidden="true">↗</span></a>}
            {site.email && <button type="button" class="button button-contact-ghost" data-copy-email={site.email}>{labels.copyEmail} <span aria-hidden="true">⧉</span></button>}
            {site.resume && <a href={site.resume} class="button button-contact-ghost" download>{labels.downloadResume} <span aria-hidden="true">↓</span></a>}
          </div>
          <nav class="contact-socials" aria-label={labels.socialNetworks}>
            {socialLinks.map(({ name, href }) => (
              <a href={href} target="_blank" rel="noopener noreferrer">
                {name}<span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </div>
        <div class="contact-bottom" data-reveal><span>{labels.letsMakeItWork}</span><span>{labels.contactTagline}</span></div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
