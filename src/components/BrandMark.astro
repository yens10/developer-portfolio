---
/** The Y monogram, drawn inline so it inherits colour from its context
    instead of sitting inside a fixed black tile. */
interface Props { class?: string; size?: number }
const { class: className, size = 26 } = Astro.props;
---
<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="55 40 210 239"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d="M 55 40 L 137.8 166.9 L 220.6 40 L 196.3 40 L 161.2 94 L 159.4 94.9 L 123.4 40 L 99.1 40 L 147.7 114.7 L 139.6 127.3 L 137.8 128.2 L 118 99.4 L 80.2 40 Z" />
  <path d="M 264.7 40 L 239.5 40 L 129.7 208.3 L 129.7 278.5 L 150.4 278.5 L 150.4 214.6 Z" />
  <path d="M 187.3 186.7 L 166.6 219.1 L 166.6 278.5 L 187.3 278.5 Z" />
</svg>
